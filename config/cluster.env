# Shared settings, sourced by every script in this repo.
# Change cluster/path settings here rather than in individual scripts.

# Repo root = parent of this config/ directory (works wherever the repo is cloned).
VLA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export VLA_ROOT

# All large files (HF cache, LIBERO assets, checkpoints, eval outputs) live here. Git-ignored.
export VLA_STORAGE="$VLA_ROOT/storage"

# ---- conda ----
CONDA_BASE="/hpc/packages/minerva-rocky9/miniforge3/26.1.1-3/miniforge"
CONDA_ENV_NAME="lerobot"

# ---- LSF defaults (override per job via lsf/submit.sh flags) ----
LSF_PROJECT="acc_pejaverlab"
LSF_QUEUE="gpu"
LSF_GPU_MODEL="a100"      # a100 | a10080g | h10080g | h100nvl | l40s
LSF_NCPU=1
LSF_MEM_MB=64000          # host RAM; pi0.5 needs >30 GB while loading weights
LSF_WALLTIME="02:00"

# ---- caches: keep everything out of $HOME ----
export HF_HOME="$VLA_STORAGE/hf_home"
export XDG_CACHE_HOME="$VLA_STORAGE/cache"
export PIP_CACHE_DIR="$VLA_STORAGE/cache/pip"
export TORCH_HOME="$VLA_STORAGE/cache/torch"
export WANDB_DIR="$VLA_STORAGE/wandb"
export LIBERO_CONFIG_PATH="$VLA_STORAGE/libero_config"
export LIBERO_ASSETS_DIR="$VLA_STORAGE/libero_assets"
# torch.compile caches (default is node-local /tmp): reuse compiled/autotuned kernels across jobs
export TORCHINDUCTOR_CACHE_DIR="$VLA_STORAGE/cache/torchinductor"
export TRITON_CACHE_DIR="$VLA_STORAGE/cache/triton"

# ---- headless rendering for MuJoCo / robosuite ----
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl

activate_env() {
    # shellcheck disable=SC1091
    source "$CONDA_BASE/etc/profile.d/conda.sh"
    conda activate "$CONDA_ENV_NAME"
}
